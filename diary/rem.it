	git init
	git config --global user.name "hoverzhao"
	git config --global user.email "gaspainton@126.com"

	ssh-keygen -t rsa -C "gaspainton@126.com"
	pbcopy < ~/.ssh/id_rsa.pub
	ssh -T git@github.com

#将本地的 Git 仓库添加一个名为 origin 的远程仓库，地址为 git@github.com:hoverzhao/coding（即 GitHub 上的一个仓库）。

	git remote add origin git@github.com:hoverzhao/coding

# 表示“将本地 master 分支推送到名为 origin 的远程仓库”。
# master 是 Git 中 默认创建的第一个分支名称（直到后来很多项目转向使用 main）。
# 你可以把 master 看作是主分支（即“主干”）。
# 在许多老项目或你自己本地 git init 时，如果没有特别设置，默认分支就是 master。

	git push origin master 


git push -u origin master
git show-ref
git push origin --delete master

#origin 为远程仓库名，main 为远程分支名 -u 为关联远程分支(只需第一次)
#重点解释：-u （也写作 --set-upstream）
#这个参数会让当前分支和远程分支建立关联（tracking relationship）。
#建立关联后，以后就可以简单地使用：
#git push（不需要加 origin HEAD:main）
#git pull（自动知道从哪里拉取）

	git push -u origin HEAD:main

#将你当前所在分支（HEAD 所指的分支）推送到远程仓库 origin 的 main 分支上。
#HEAD 是 Git 当前指向的分支，也就是你当前所在的分支。
#举例：如果你现在在 dev分支上 HEAD就等于dev
	git push origin HEAD:main


#合并冲突
git config pull.rebase false
git pull origin main --allow-unrelated-histories

git mergetool 

git commit . -m "merge"



git log
git reset --hard 445e4d
删除最近一次提交,改变、不改变本地文件
git reset --hard HEAD^
git reset --soft HEAD^

